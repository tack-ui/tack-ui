{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "env": {
    "es2020": true,
    "node": true
  },

  "exclude": ["node_modules", "dist", "styled-system"],

  "plugins": [
    "node",
    "eslint",
    "oxc",
    "unicorn",
    "import",
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y"
  ]
}
